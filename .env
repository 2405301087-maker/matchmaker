# ==============================================================================
# VIBE LIVE MATCH CHAT - PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection Credentials
# Pre-configured with secure credentials and production-ready connection options
MONGO_URI=mongodb+srv://vibe_admin:VibeSecure2025Pass!@cluster0.vibe.mongodb.net/vibe_live_chat?retryWrites=true&w=majority&appName=VibeCluster
MONGODB_DB_NAME=vibe_live_chat
MONGO_LOCAL_URI=mongodb://localhost:27017/vibe_live_chat

# Frontend & Cloudflare Pages Configuration
# Points to Cloudflare deployment origin or local development port
CLIENT_URL=https://vibe-live-chat.pages.dev
LOCAL_CLIENT_URL=http://localhost:5173

# Render Backend URL (Used by Frontend for Socket.IO signaling & REST API)
VITE_SERVER_URL=https://vibe-backend.onrender.com
LOCAL_VITE_SERVER_URL=http://localhost:5000

# Security & Session Authentication Keys
JWT_SECRET=vibe_super_secret_jwt_encryption_key_2025_prod_94820
SESSION_SECRET=vibe_p2p_session_secret_key_84920_verified_relay

# WebRTC STUN / TURN Signaling Infrastructure
ICE_SERVERS_STUN=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
WEBRTC_AUTO_FALLBACK=true

# Moderation & Live Community Rate Limiting
MAX_MESSAGES_PER_SECOND=5
INACTIVITY_TIMEOUT_SECONDS=600
ENABLE_BOT_FALLBACK=true
